# ============================================
# CONFIGURATION ENVIRONNEMENT
# Gestion de Stock Frontend
# ============================================

# API Backend
API_URL=http://localhost:3000/api

# Environnement
PRODUCTION=false

# Fonctionnalités
ENABLE_DEBUG=true
ENABLE_ANALYTICS=false

# Auth
JWT_STORAGE_KEY=gestion_stock_token
USER_STORAGE_KEY=gestion_stock_user

# Cache
CACHE_TTL=300000

# Pagination
DEFAULT_PAGE_SIZE=20

# Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=image/jpeg,image/png,image/gif,application/pdf

# Notifications
TOAST_DURATION=5000

# Premium
PREMIUM_TRIAL_DAYS=14
